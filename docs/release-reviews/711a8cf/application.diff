+          'y',
+          'rotation',
+        ],
+      },
+    ],
+    [sleeve, cap.id],
+    'Lengthen the sleeve symmetrically by 0.46 m and retain the loose cap clearance.',
+  );
+  let calls = 0;
+  const result = await stagedPlan(
+    original,
+    defaultCamera,
+    async (working) => {
+      if (++calls === 1)
+        return {
+          intent: 'apply',
+          message: 'Lengthen sleeve',
+          operations: [
+            {
