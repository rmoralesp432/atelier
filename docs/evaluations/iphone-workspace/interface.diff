+  width: 80px;
+  height: 80px;
+}
+.phone-workspace .orb-dock .audio-orb {
+  width: 64px;
+  height: 64px;
+}
+.phone-workspace .orb-dock .voice-mute {
+  position: absolute;
+  bottom: 88px;
+  left: 18px;
+  width: 44px;
+  height: 44px;
