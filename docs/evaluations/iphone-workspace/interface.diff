+  gap: 5px;
+  min-width: 44px;
+  min-height: 56px;
+  border-radius: 20px;
+  padding: 5px 0;
+  color: var(--muted);
+  font-size: 10px;
+  font-weight: 500;
+  touch-action: manipulation;
