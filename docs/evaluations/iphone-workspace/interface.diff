+/* Touch workspace chrome. No model, camera or project state depends on these layouts. */
+.phone-workspace-dock {
+  display: none;
+}
+.immersive.phone-workspace {
+  --phone-dock-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
+  --phone-sheet-bottom: calc(92px + env(safe-area-inset-bottom, 0px));
+  min-height: 0;
+  height: 100dvh;
+  overscroll-behavior: none;
+}
+.immersive.phone-workspace .app-header {
+  height: calc(58px + env(safe-area-inset-top, 0px));
+  min-height: calc(58px + env(safe-area-inset-top, 0px));
+  padding: env(safe-area-inset-top, 0px) max(16px, env(safe-area-inset-right)) 0
+    max(12px, env(safe-area-inset-left));
+  gap: 10px;
+  background: var(--chrome);
+}
+.phone-workspace
+  .app-header
+  > :is(.scene-toggle, .primary-create, .compact-tools-toggle) {
+  display: none;
+}
+.phone-workspace .app-header .brand {
+  width: 44px;
+  flex: 0 0 44px;
+  min-height: 44px;
+  justify-content: center;
+}
+.phone-workspace .app-header > .project-switcher {
+  flex: 1;
+  min-width: 0;
+  max-width: none;
+  width: auto;
+  margin: 0 96px 0 0;
+  padding: 8px 0;
+  border: 0;
+  font-size: 16px;
+  font-weight: 500;
+  color: var(--ui-text);
+  text-align: left;
+}
+.phone-workspace .project-switcher svg {
+  display: none;
+}
+.phone-workspace .app-header > .explore-launcher {
+  min-width: 44px;
+  min-height: 44px;
+  padding: 12px;
+}
+.phone-workspace .explore-launcher span {
+  display: none;
+}
+.phone-workspace .phone-workspace-dock {
+  position: fixed;
+  z-index: 35;
+  bottom: var(--phone-dock-bottom);
+  left: max(12px, env(safe-area-inset-left));
+  right: max(12px, env(safe-area-inset-right));
