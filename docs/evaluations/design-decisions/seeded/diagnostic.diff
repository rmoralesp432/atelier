+  if ([2, 3, 4, 10].includes(turn)) {
+    allowed = [b.cube];
+    req.push(
+      measured(
+        'side-dimension',
+        selector(allowed),
+        turn === 3 ? 'width' : turn === 4 ? 'depth' : 'height',
+        turn === 2 ? 0.5 : turn === 3 ? 0.55 : turn === 4 ? 0.45 : 0.6,
+      ),
+    );
+  } else if ([5, 9].includes(turn)) {
