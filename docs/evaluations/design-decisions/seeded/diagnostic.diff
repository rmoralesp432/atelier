+export function connectedCriteria(turn: 12 | 13, s: Session) {
+  const b = bindings(s),
+    top = 0.35,
+    gap = turn === 12 ? 0.32 : 0.18;
+  const sel = (id: string) => selector([id]);
+  const allowed =
+    turn === 13
+      ? b.frame
+      : s.project.volumes
+          .filter((v) => ![b.cube, b.puck].includes(v.id))
+          .map((v) => v.id);
