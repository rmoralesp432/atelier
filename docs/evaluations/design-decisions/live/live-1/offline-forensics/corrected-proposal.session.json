    "design": {
      "views": [],
      "options": [],
      "notes": [
        {
          "topic": "Scanning rig dimensions and usable loading space",
          "text": "Maintain the circular 0.70 m turntable at top elevation 0.24 m and the centered overhead panel underside at 0.56 m, leaving exactly 0.32 m clear. Preserve usable sample-loading space during subsequent development. Keep parts independently editable. The separate storage cube is 0.40 m per side; its center is 2 m to world-X left of the turntable, on the same Z centerline.",
          "source": "user",
          "decision": {
            "id": "70db6f56-f975-420f-b5e7-3b4781cfe63e",
            "revision": 1,
            "quote": "Create a small editable tabletop scanning rig. Use a circular turntable 70 cm across with its top 24 cm above the floor, and an overhead rectangular light panel centered over it, supported by a freestanding frame with two posts and a crossbeam. Leave exactly 32 cm clear between the turntable top and the underside of the light panel so bulky samples can be inserted. Keep that sample-loading space usable as we develop the rig. Add a separate 40 cm storage cube two meters to the left. Keep the parts separate and choose sensible dimensions for the frame.",
            "origin": {
              "id": "3f41ec6f-0223-4542-af00-86e23f48a41a",
              "text": "Create a small editable tabletop scanning rig. Use a circular turntable 70 cm across with its top 24 cm above the floor, and an overhead rectangular light panel centered over it, supported by a freestanding frame with two posts and a crossbeam. Leave exactly 32 cm clear between the turntable top and the underside of the light panel so bulky samples can be inserted. Keep that sample-loading space usable as we develop the rig. Add a separate 40 cm storage cube two meters to the left. Keep the parts separate and choose sensible dimensions for the frame."
            }
          }
        }
      ]
    }
