+      2,
+    ),
+  );
+  writeFileSync(
+    info.outputPath('evidence.json'),
+    JSON.stringify(
+      {
+        provenance:
+          'Scripted provider and independent criteria; actual App/provider tools/geometry/commit/reload/Undo/Redo. No paid API calls.',
+        prompts: [createPrompt, editPrompt],
