{
  "name": "atelier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --use-env-proxy --import tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run test:e2e",
    "format": "prettier --write src server tests scripts docs .github *.json *.ts *.html *.md",
    "format:check": "prettier --check src server tests scripts docs .github *.json *.ts *.html *.md",
    "test:pages": "node scripts/test-pages.mjs",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --use-env-proxy --import tsx server/index.ts",
    "test:live-ai": "node --env-file-if-exists=.env --use-env-proxy --import tsx scripts/test-live-ai.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "manifold-3d": "^3.5.4",
    "openai": "^7.33.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
