# Server only. Supply values securely; never commit .env or prefix secrets with VITE_.
ATELIER_OPENAI_API_KEY=
ATELIER_TEXT_MODEL=gpt-4.1
ATELIER_VOICE_MODEL=gpt-realtime
# Required when serving the AI backend in production.
ATELIER_APP_PASSWORD=
# Exact public HTTPS origin behind your reverse proxy, e.g. https://your-atelier.example
# Render's default URL is detected automatically; set this only for a custom domain.
ATELIER_ORIGIN=
PORT=5173
